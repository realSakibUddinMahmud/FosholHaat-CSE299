{
  "installCommand": "npm ci",
  "buildCommand": "npm -w apps/api run prisma:generate && npm -w apps/api run build",
  "framework": null,
  "outputDirectory": "apps/api",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
