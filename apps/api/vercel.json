{
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm -w apps/api run prisma:generate && npm -w apps/api run build",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
