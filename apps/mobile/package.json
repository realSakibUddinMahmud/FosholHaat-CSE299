{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint App.tsx index.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "eas-build-post-install": "npm -w @fosholhaat/types run build"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@fosholhaat/types)"
    ]
  },
  "dependencies": {
    "@fosholhaat/tokens": "^0.1.0",
    "@fosholhaat/types": "^0.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "expo": "^55.0.0",
    "expo-camera": "~55.0.18",
    "expo-constants": "~55.0.9",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.9",
    "expo-print": "~55.0.14",
    "expo-router": "~55.0.8",
    "expo-sharing": "~55.0.18",
    "expo-status-bar": "~55.0.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.83.0",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~55.0.13",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "jest-expo": "~55.0.11",
    "react-test-renderer": "19.2.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.2"
  },
  "private": true
}
